# Copy to .env and fill in from your Supabase project (Settings -> API).
# Only VITE_-prefixed vars are exposed to the browser. Never put service-role
# keys or the QR HMAC secret here — those live server-side in Edge Functions.

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Face-verification tuning (client-side face-api.js).
# Euclidean distance threshold: a live selfie matches the enrolled template
# when distance <= this value. Lower = stricter. Start ~0.55, calibrate on
# real faculty data (see §9 of the spec).
VITE_FACE_MATCH_THRESHOLD=0.55

# Number of face/liveness attempts before the manual-override path is offered.
VITE_FACE_MAX_ATTEMPTS=3

# Geofence soft-flag threshold in metres. Scans farther than this from the
# room's stored coordinates are flagged (never hard-blocked). See §8.
VITE_GEOFENCE_FLAG_METERS=75

# Current privacy-policy version shown at enrollment (stored in consent_records).
VITE_PRIVACY_POLICY_VERSION=2026-01
